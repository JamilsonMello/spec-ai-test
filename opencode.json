{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "build",
  "share": "disabled",
  "autoupdate": false,
  "instructions": ["CLAUDE.md"],
  "provider": {
    "anthropic": {
      "options": { "apiKey": "{env:ANTHROPIC_API_KEY}" }
    },
    "openai": {
      "options": { "apiKey": "{env:OPENAI_API_KEY}" }
    },
    "google": {
      "options": { "apiKey": "{env:GEMINI_API_KEY}" }
    },
    "openrouter": {
      "options": { "apiKey": "{env:OPENROUTER_API_KEY}" }
    },
    "deepseek": {
      "options": { "apiKey": "{env:DEEPSEEK_API_KEY}" }
    },
    "moonshot-ai": {
      "options": { "apiKey": "{env:MOONSHOT_API_KEY}" }
    },
    "zai": {
      "options": { "apiKey": "{env:GLM_API_KEY}" }
    },
    "xai": {
      "options": { "apiKey": "{env:XAI_API_KEY}" }
    },
    "groq": {
      "options": { "apiKey": "{env:GROQ_API_KEY}" }
    },
    "together-ai": {
      "options": { "apiKey": "{env:TOGETHER_API_KEY}" }
    },
    "fireworks-ai": {
      "options": { "apiKey": "{env:FIREWORKS_API_KEY}" }
    },
    "cerebras": {
      "options": { "apiKey": "{env:CEREBRAS_API_KEY}" }
    },
    "deep-infra": {
      "options": { "apiKey": "{env:DEEPINFRA_API_KEY}" }
    },
    "minimax": {
      "options": { "apiKey": "{env:MINIMAX_API_KEY}" }
    },
    "venice-ai": {
      "options": { "apiKey": "{env:VENICE_API_KEY}" }
    }
  },
  "permission": {
    "bash": "allow",
    "read": "allow",
    "write": "allow",
    "edit": "allow",
    "glob": "allow",
    "grep": "allow",
    "fetch": "allow",
    "notebook_edit": "allow",
    "mcp": "allow",
    "external_directory": "allow"
  },
  "agent": {
    "build": {
      "steps": 100
    }
  }
}